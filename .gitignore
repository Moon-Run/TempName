# Source inputs in the pre-optimization freeze, not generated build products.
!/outputs/h100/phase6/frozen-candidate-v1-20261013/source/.gitmodules
!/outputs/h100/phase6/frozen-candidate-v1-20261013/source/**/.clang-format
!/outputs/h100/phase6/frozen-candidate-v1-20261013/source/**/*.ld
!/outputs/h100/phase6/frozen-candidate-v1-20261013/source/**/*.sbatch
!/outputs/h100/phase6/frozen-candidate-v1-20261013/source/python/flux_triton/extra/cuda_extra.bc
!/outputs/h100/phase6/frozen-candidate-v1-20261013/source/python/flux_triton/extra/cuda_extra.ll

# Exact source inputs in new independent ablation snapshots (not build products).
!/outputs/h100/phase6/ablation-*/**/builds/**/*.ld
!/outputs/h100/phase6/ablation-*/**/builds/**/.clang-format
!/outputs/h100/phase6/ablation-*/**/builds/**/python/flux_triton/extra/cuda_extra.bc
!/outputs/h100/phase6/ablation-*/**/builds/**/python/flux_triton/extra/cuda_extra.ll
!/outputs/h100/phase6/ablation2-*/**/builds/**/*.ld
!/outputs/h100/phase6/ablation2-*/**/builds/**/.clang-format
!/outputs/h100/phase6/ablation2-*/**/builds/**/python/flux_triton/extra/cuda_extra.bc
!/outputs/h100/phase6/ablation2-*/**/builds/**/python/flux_triton/extra/cuda_extra.ll
!/outputs/h100/phase6/ablation3-*/**/*.ld
!/outputs/h100/phase6/ablation3-*/**/.clang-format
!/outputs/h100/phase6/ablation3-*/**/python/flux_triton/extra/cuda_extra.bc
!/outputs/h100/phase6/ablation3-*/**/python/flux_triton/extra/cuda_extra.ll

# Local ablation CPU rehearsals: generated source copies, plans, dry-runs and
# validation logs stay on this machine. Keep maintained code and GPU evidence.
/outputs/h100/phase6/ablation-*-cpu-*/
/logs/h100/phase6/ablation-*-cpu-*/
/outputs/h100/phase6/ablation-*/**/cpu-compile/
/outputs/h100/phase6/ablation2-*-cpu-*/
/logs/h100/phase6/ablation2-*-cpu-*/
/outputs/h100/phase6/ablation2-*/**/cpu-compile/
/outputs/h100/phase6/ablation3-*-cpu-*/
/logs/h100/phase6/ablation3-*-cpu-*/
/outputs/h100/phase6/ablation3-*/**/cpu-compile/

# Local Attention/MLP scope CPU rehearsal and compile artifacts.
/outputs/h100/phase6/mlp-attention-*-cpu-*/
/logs/h100/phase6/mlp-attention-*-cpu-*/
/outputs/h100/phase6/mlp-attention-*/**/cpu-compile/

# Exact inputs in formal scope source snapshots; runtime binaries stay ignored.
!/outputs/h100/phase6/mlp-attention-*/**/.clang-format
!/outputs/h100/phase6/mlp-attention-*/**/*.ld
!/outputs/h100/phase6/mlp-attention-*/**/python/flux_triton/extra/cuda_extra.bc
!/outputs/h100/phase6/mlp-attention-*/**/python/flux_triton/extra/cuda_extra.ll

