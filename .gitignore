!/outputs/h100/phase6/TTention-MLP-*/**/.clang-format
!/outputs/h100/phase6/TTention-MLP-*/**/*.ld
!/outputs/h100/phase6/TTention-MLP-*/**/python/flux_triton/extra/cuda_extra.bc
!/outputs/h100/phase6/TTention-MLP-*/**/python/flux_triton/extra/cuda_extra.ll

