# Experiment artifacts: raw results, profiles, per-run source snapshots,
# allocation controls, downloaded data, environments and frozen builds.
# Maintain reusable code in tools/, src/, include/ and python/ instead.
/outputs/
/logs/
/log/
/prof/
/workspace/
/tmp/
/data/
/checkpoints/
/runs/
/wandb/
/tensorboard/



# Do not blanket-ignore JSON/CSV/Markdown: configs and test fixtures are source.
# Do not ignore *.bc or *.ll: python/flux_triton/extra/cuda_extra.* is required.

# Logs and profiler exports produced outside the artifact directories.
*.log
*.log.*
slurm-*.out
slurm-*.err
*.nsys-rep
*.ncu-rep
*.qdrep
report*.sqlite
report*.sqlite-*

# CMake/Ninja and native compilation products.
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands*.json
build.ninja
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.so
*.so.*
*.cubin
*.fatbin

# Python packaging, generated version metadata and local environments.
dist/
*.egg-info/
.eggs/
*.egg
*.whl
*.py[cod]
__pycache__/
/python/flux/version.py
.venv/
venv/

# Tool caches and test/coverage outputs.
.cache/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Editor temporary files.
*~
*.swp
*.swo
.DS_Store

# Preserve H100 run results and the source/configuration files needed to
# analyze them on another server. Compiled libraries, wheels and build trees
# remain ignored.
!/logs/
/logs/*
!/logs/h100/
!/logs/h100/**
/logs/h100/**/__pycache__/
/logs/h100/**/*.pyc
/logs/h100/**/*.lock

!/outputs/
/outputs/*
!/outputs/h100/
/outputs/h100/**
!/outputs/h100/**/
!/outputs/h100/**/*.json
!/outputs/h100/**/*.jsonl
!/outputs/h100/**/*.csv
!/outputs/h100/**/*.md
!/outputs/h100/**/*.txt
!/outputs/h100/**/*.log
!/outputs/h100/**/*.py
!/outputs/h100/**/*.pyi
!/outputs/h100/**/*.sh
!/outputs/h100/**/*.toml
!/outputs/h100/**/*.yaml
!/outputs/h100/**/*.yml
!/outputs/h100/**/*.c
!/outputs/h100/**/*.cc
!/outputs/h100/**/*.cpp
!/outputs/h100/**/*.h
!/outputs/h100/**/*.hpp
!/outputs/h100/**/*.cu
!/outputs/h100/**/*.cuh
!/outputs/h100/**/*.cmake
!/outputs/h100/**/*.mk
!/outputs/h100/**/*.in
!/outputs/h100/**/.gitignore
!/outputs/h100/**/CMakeLists.txt
!/outputs/h100/**/Makefile
!/outputs/h100/**/LICENSE
/outputs/h100/**/build/
/outputs/h100/**/wheelhouse/
/outputs/h100/**/nccl/
/outputs/h100/**/nccl-release/

# Local H100 compile checks and short-run artifacts.
/logs/h100/phase6/tp4-short-20261009-205658/
/outputs/h100/phase6/compile-check-20261009-r2/
/outputs/h100/phase6/compile-check-20261009/
/outputs/h100/phase6/source-check-final-20261009/

